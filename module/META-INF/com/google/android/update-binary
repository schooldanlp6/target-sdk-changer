#!/sbin/sh
# Standard Magisk module installer stub (Magisk 20.4+).
umask 022
OUTFD=$2
ZIPFILE=$3
mount /data 2>/dev/null
[ -f /data/adb/magisk/util_functions.sh ] || { echo "ui_print Please install Magisk v20.4+" >/proc/self/fd/$OUTFD; exit 1; }
. /data/adb/magisk/util_functions.sh
[ $MAGISK_VER_CODE -lt 20400 ] && { ui_print "Please install Magisk v20.4+"; exit 1; }
install_module
exit 0
